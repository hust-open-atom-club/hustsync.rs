{
  "title": "hustsync · 运维",
  "uid": "hustsync-ops",
  "description": "告警、抓取、worker、进程与程序日志",
  "tags": [
    "hustsync",
    "tunasync",
    "mirror"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "title": "总览",
      "type": "link",
      "url": "/d/hustsync",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "镜像",
      "type": "link",
      "url": "/d/hustsync-mirrors",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "InfluxDB",
      "type": "link",
      "url": "/d/hustsync-influx",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "hustsync",
      "type": "link",
      "url": "https://github.com/hust-open-atom-club/hustsync.rs",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "p8s",
        "label": "指标",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "hustsync-p8s"
        },
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "name": "loki",
        "label": "日志",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Loki",
          "value": "hustsync-loki"
        },
        "hide": 0,
        "refresh": 1,
        "options": []
      },
      {
        "name": "worker",
        "label": "worker",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${p8s}"
        },
        "query": {
          "query": "label_values(hustsync_mirror_state, worker)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(hustsync_mirror_state, worker)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "options": []
      },
      {
        "name": "mirror",
        "label": "镜像",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${p8s}"
        },
        "query": {
          "query": "label_values(hustsync_mirror_state{worker=~\"$worker\"}, mirror)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(hustsync_mirror_state{worker=~\"$worker\"}, mirror)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "正在触发的告警",
      "description": "Prometheus 按 deploy/prometheus/rules.yml 判断",
      "datasource": {
        "type": "prometheus",
        "uid": "${p8s}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${p8s}"
          },
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\", alertname=~\"Hustsync.*\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "Value": true,
              "alertstate": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "alertname": "告警",
              "severity": "级别",
              "mirror": "镜像",
              "worker": "worker"
            },
            "indexByName": {
              "severity": 0,
              "alertname": 1,
              "mirror": 2,
              "worker": 3
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "告警"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "HustsyncManagerDown": {
                        "text": "manager 抓取失败",
                        "index": 0
                      },
                      "HustsyncWorkerDown": {
                        "text": "worker 不响应",
                        "index": 1
                      },
                      "HustsyncMirrorFailing": {
                        "text": "镜像连续失败",
                        "index": 2
                      },
                      "HustsyncMirrorStale": {
                        "text": "镜像久未成功",
                        "index": 3
                      },
                      "HustsyncMirrorOverdue": {
                        "text": "过了排期未开始",
                        "index": 4
                      },
                      "HustsyncMirrorStuck": {
                        "text": "同步超过一天",
                        "index": 5
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "级别"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "text": "严重",
                        "color": "#F2495C",
                        "index": 0
                      },
                      "warning": {
                        "text": "警告",
                        "color": "#FF9830",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "id": 1,
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "state-timeline",
      "title": "抓取",
      "description": "Prometheus 每次抓取是否成功",
      "datasource": {
        "type": "prometheus",
        "uid": "${p8s}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${p8s}"
          },
          "refId": "A",
          "expr": "up{job=~\"hustsync-.*\"}",
          "legendFormat": "{{job}} · {{instance}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "失败",
                  "color": "#F2495C",
                  "index": 0
                },
                "1": {
                  "text": "正常",
                  "color": "#73BF69",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.75,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 0
      }
    },
    {
      "type": "row",
      "id": 3,
      "title": "worker",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "status-history",
      "title": "在线",
      "description": "manager 能否连上 worker，worker 能否连上 manager；每格五分钟",
      "datasource": {
        "type": "prometheus",
        "uid": "${p8s}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${p8s}"
          },
          "refId": "A",
          "expr": "hustsync_worker_up{worker=~\"$worker\"}",
          "legendFormat": "{{worker}}",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${p8s}"
          },
          "refId": "B",
          "expr": "label_replace(hustsync_worker_manager_up, \"host\", \"$1\", \"instance\", \"([^:]+):.*\")",
          "legendFormat": "{{host}} → manager",
          "instant": false,
          "range": true
        }
      ],
      "interval": "5m",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "离线",
                  "color": "#F2495C",
                  "index": 0
                },
                "1": {
                  "text": "在线",
                  "color": "#73BF69",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "colWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "timeseries",
      "title": "运行中",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${p8s}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${p8s}"
          },
          "refId": "A",
          "expr": "label_replace(sum by (instance) (hustsync_worker_jobs_running), \"host\", \"$1\", \"instance\", \"([^:]+):.*\")",
          "legendFormat": "{{host}}",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${p8s}"
          },
          "refId": "B",
          "expr": "sum(hustsync_worker_concurrency)",
          "legendFormat": "并发上限",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "barAlignment": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisBorderShow": false,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "并发上限"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8E8E8E"
                }
              },
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "B"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      }
    },
    {
      "type": "timeseries",
      "title": "排队",
      "description": "已排期、等下一次同步的镜像数",
      "datasource": {
        "type": "prometheus",
        "uid": "${p8s}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${p8s}"
          },
          "refId": "A",
          "expr": "label_replace(sum by (instance) (hustsync_worker_jobs_queued), \"host\", \"$1\", \"instance\", \"([^:]+):.*\")",
          "legendFormat": "{{host}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "barAlignment": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisBorderShow": false,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      }
    },
    {
      "type": "row",
      "id": 7,
      "title": "进程",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "description": "占一个核的比例",
      "datasource": {
        "type": "prometheus",
        "uid": "${p8s}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${p8s}"
          },
          "refId": "A",
          "expr": "label_replace(rate(process_cpu_seconds_total{job=\"hustsync-process\"}[5m]), \"host\", \"$1\", \"instance\", \"([^:]+):.*\")",
          "legendFormat": "{{host}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisBorderShow": false,
            "axisSoftMin": 0,
            "axisSoftMax": 0.05
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 19
      }
    },
    {
      "type": "timeseries",
      "title": "内存",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${p8s}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${p8s}"
          },
          "refId": "A",
          "expr": "label_replace(process_resident_memory_bytes{job=\"hustsync-process\"}, \"host\", \"$1\", \"instance\", \"([^:]+):.*\")",
          "legendFormat": "{{host}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisBorderShow": false,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 19
      }
    },
    {
      "type": "timeseries",
      "title": "线程",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${p8s}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${p8s}"
          },
          "refId": "A",
          "expr": "label_replace(process_threads{job=\"hustsync-process\"}, \"host\", \"$1\", \"instance\", \"([^:]+):.*\")",
          "legendFormat": "{{host}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisBorderShow": false,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10,
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 19
      }
    },
    {
      "type": "timeseries",
      "title": "文件句柄",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${p8s}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${p8s}"
          },
          "refId": "A",
          "expr": "label_replace(process_open_fds{job=\"hustsync-process\"}, \"host\", \"$1\", \"instance\", \"([^:]+):.*\")",
          "legendFormat": "{{host}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisBorderShow": false,
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 19
      }
    },
    {
      "type": "row",
      "id": 12,
      "title": "日志",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "程序日志量",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "expr": "sum by (level) (count_over_time({source=\"program\"} [$__auto]))",
          "legendFormat": "{{level}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "smooth",
            "barAlignment": 0,
